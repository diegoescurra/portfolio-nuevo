---
import ProjectList from "@/components/ui/ProjectList.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Layout title="Proyectos | Diego Escurra">
    <main>
        <section class="mx-auto max-w-[1440px] px-5 py-18 lg:px-9 lg:py-24">
            <p class="text-sm font-bold tracking-[0.14em] text-[var(--color-text)]">PROYECTOS</p>
            <h1
                class="mt-2 max-w-[640px] text-4xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]"
            >
                Soluciones creadas para problemas reales
            </h1>
            <p class="mt-4 max-w-[640px] leading-6 text-[var(--color-text)]">
                Una selección de sitios y aplicaciones desarrollados para impulsar negocios.
            </p>
            <div class="mt-10"><ProjectList projects={projects} headingLevel={2} /></div>
        </section>
    </main>
</Layout>
