---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex((item) => item.id === project.id);
const previousProject = projects[currentIndex - 1];
const nextProject = projects[currentIndex + 1];
const { data } = project;
---

<Layout title={`${data.title} | Diego Escurra`} headerOverlay>
    <main>
        <section class="mx-auto max-w-[1440px] px-5 pb-12 pt-28 lg:px-9 lg:pb-16 lg:pt-32">
            <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 text-sm">
                <a href="/proyectos" class="font-medium text-[var(--color-primary)] transition-colors hover:text-[var(--color-accent)]">
                    &larr; Volver a proyectos
                </a>
                <nav class="flex items-center gap-5 text-[var(--color-text)]" aria-label="Navegación entre proyectos">
                    {previousProject && <a href={`/proyectos/${previousProject.id}`} class="hover:text-[var(--color-primary)]">Proyecto anterior</a>}
                    {nextProject && <a href={`/proyectos/${nextProject.id}`} class="hover:text-[var(--color-primary)]">Proyecto siguiente &rarr;</a>}
                </nav>
            </div>

            <div class="mt-12 grid items-center gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-16">
                <div>
                    <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)] uppercase">{data.category} · {data.role}</p>
                    <h1 class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-[var(--color-primary)] sm:text-5xl lg:text-6xl">{data.title}</h1>
                    <p class="mt-4 max-w-xl text-xl leading-8 text-[var(--color-primary-soft)]">{data.description}</p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        {data.website && <a href={data.website} target="_blank" rel="noreferrer" class="rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90">Visitar sitio &rarr;</a>}
                        {data.repository && <a href={data.repository} target="_blank" rel="noreferrer" class="rounded-xl border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-primary)] transition-colors hover:border-[var(--color-primary)]">Ver código</a>}
                    </div>
                </div>

                <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-[var(--color-surface-soft)]">
                    <Image
                        src={data.cover}
                        alt={data.coverAlt}
                        widths={[640, 960, 1280, 1600]}
                        sizes="(min-width: 1024px) 55vw, 100vw"
                        class="h-full w-full object-cover"
                    />
                </div>
            </div>
        </section>

        <section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]">
            <dl class="mx-auto grid max-w-[1440px] gap-px px-5 sm:grid-cols-2 lg:grid-cols-4 lg:px-9">
                <div class="border-b border-[var(--color-border)] py-6 sm:border-r lg:border-b-0"><dt class="text-sm text-[var(--color-text)]">Cliente</dt><dd class="mt-1 font-medium text-[var(--color-primary)]">{data.client}</dd></div>
                <div class="border-b border-[var(--color-border)] py-6 lg:border-b-0 lg:border-r"><dt class="text-sm text-[var(--color-text)]">Año</dt><dd class="mt-1 font-medium text-[var(--color-primary)]">{data.year}</dd></div>
                <div class="border-b border-[var(--color-border)] py-6 sm:border-r sm:border-b-0 lg:border-r"><dt class="text-sm text-[var(--color-text)]">Rol</dt><dd class="mt-1 font-medium text-[var(--color-primary)]">{data.role}</dd></div>
                <div class="py-6"><dt class="text-sm text-[var(--color-text)]">Sitio web</dt><dd class="mt-1 font-medium text-[var(--color-primary)]">{data.website ? <a class="hover:text-[var(--color-accent)]" href={data.website} target="_blank" rel="noreferrer">{new URL(data.website).hostname.replace('www.', '')}</a> : 'No disponible'}</dd></div>
            </dl>
        </section>

        <section class="mx-auto grid max-w-5xl gap-10 px-5 py-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(360px,0.95fr)] lg:py-20">
            <div class="max-w-2xl">
                <div class="project-content text-[var(--color-text)]"><Content /></div>
            </div>

            <aside class="space-y-6">
                <section class="rounded-2xl bg-[var(--color-surface-soft)] p-6 sm:p-8">
                    <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)] uppercase">Tecnologías</p>
                    <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3" aria-label="Tecnologías utilizadas">
                        {data.stack.map((item) => <li class="border-l border-[var(--color-border)] pl-3 text-sm font-medium text-[var(--color-primary)]">{item}</li>)}
                    </ul>
                </section>

                <section class="rounded-2xl bg-[var(--color-surface-soft)] p-6 sm:p-8">
                    <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)] uppercase">Mi trabajo</p>
                    <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">¿Qué hice?</h2>
                    <ul class="mt-5 space-y-3 text-sm leading-6 text-[var(--color-text)]">
                        {data.highlights.map((highlight) => <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>{highlight}</li>)}
                    </ul>
                </section>
            </aside>
        </section>

        {data.quote && (
            <section class="mx-auto max-w-5xl px-5 pb-14 lg:pb-20">
                <figure class="grid overflow-hidden rounded-2xl bg-[var(--color-surface)] shadow-sm md:grid-cols-[minmax(0,1fr)_18rem]">
                    <blockquote class="flex gap-5 p-6 sm:p-8">
                        <span class="text-4xl font-bold leading-none text-[var(--color-accent)]" aria-hidden="true">&ldquo;</span>
                        <div>
                            <p class="text-base leading-7 text-[var(--color-primary-soft)]">{data.quote}</p>
                            <figcaption class="mt-4 text-sm font-medium text-[var(--color-primary)]">&mdash; {data.client}</figcaption>
                        </div>
                    </blockquote>
                    <Image
                        src={data.cover}
                        alt=""
                        widths={[320, 480, 640]}
                        sizes="(min-width: 768px) 18rem, 100vw"
                        class="h-40 w-full object-cover object-center md:h-full"
                    />
                </figure>
            </section>
        )}

        <section class="mx-auto max-w-5xl px-5 pb-14 lg:pb-20">
            <div class="rounded-2xl bg-[var(--color-accent-soft)] px-6 py-8 sm:px-10 sm:py-10">
                <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-accent)] uppercase">¿Tienes un proyecto similar?</p>
                <div class="mt-3 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                    <div><h2 class="text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">Hablemos sobre tu idea</h2><p class="mt-2 text-[var(--color-text)]">Cuéntame lo que necesitas y veamos cómo hacerlo realidad.</p></div>
                    <a href="/contacto" class="w-fit rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90">Contactar &rarr;</a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .project-content :global(h2) {
        margin-top: 2rem;
        color: var(--color-primary);
        font-size: 1.875rem;
        font-weight: 600;
        letter-spacing: -0.04em;
    }

    .project-content :global(h2:first-child) {
        margin-top: 0;
    }

    .project-content :global(p) {
        margin-top: 1rem;
        font-size: 1rem;
        line-height: 1.75;
    }
</style>
