---
import Education from '@/components/profile/Education.astro';
import Experience from '@/components/profile/Experience.astro';
import ProfileContact from '@/components/profile/ProfileContact.astro';
import ProfileHero from '@/components/profile/ProfileHero.astro';
import Skills from '@/components/profile/Skills.astro';
import TechnicalProjects from '@/components/profile/TechnicalProjects.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Perfil técnico | Diego Escurra">
	<main class="mx-auto max-w-[1440px] px-5 lg:px-9">
		<ProfileHero />
		<div class="grid gap-10 border-t border-[var(--color-border)] py-10 md:py-12 lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)] lg:items-start lg:gap-16">
			<Experience />
			<Skills />
		</div>
		<TechnicalProjects />
		<Education />
		<ProfileContact />
	</main>
</Layout>
