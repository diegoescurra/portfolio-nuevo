---
import { ArrowRight, ChevronDown } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import cclm from "@/assets/images/cclm.jpg";
import merp from "@/assets/projects/merp/merp.png";
import portteck from "@/assets/projects/portteck/portteck.png";
import { WHATSAPP_URL } from "@/contact";


const services = [
    {
        title: "Sitios web para negocios",
        description:
            "Sitios para presentar tus servicios y facilitar consultas o reservas. Desarrollo landing pages y webs con varias páginas, con acceso a WhatsApp, reservas y contenido administrable según tus necesidades.",
        link: "/proyectos/merp",
        linkLabel: "Ver Merp",
        imageLabel: "Imágen de sitio web de Merp.",
        image: merp
    },
    {
        title: "Aplicaciones e integraciones",
        description:
            "Gestiona información y conecta herramientas de trabajo. Desarrollo paneles y aplicaciones a medida, con publicación de contenido y conexión a servicios externos.",
        link: "https://www.portteck.cl/",
        linkLabel: "Ver Portteck",
        badge: "Proyecto archivado",
        imageLabel: "Imágen de aplicación de Portteck.",
        image: portteck
    },
    {
        title: "Mantenimiento y mejoras",
        description:
            "Corrige problemas y adapta tu plataforma a nuevas necesidades. Trabajo en errores, rendimiento, experiencia móvil y nuevas funcionalidades, previa revisión del sitio existente.",
        link: "https://www.cclm.cl/",
        linkLabel: "Ver Experiencia",
        imageLabel: "Imágen de CCLM, Centro Cultural La Moneda.",
        image: cclm
    },
];

const questions = [
    {
        question: "¿Puedes trabajar sobre un sitio existente?",
        answer:
            "Sí, primero reviso el estado del sitio, la tecnología utilizada y el alcance de los cambios para confirmar la mejor forma de trabajar sobre él.",
    },
    {
        question: "¿Podré actualizar el contenido por mi cuenta?",
        answer:
            "Sí el proyecto lo requiere, puedo dejar preparado un sistema de gestión para que actualices textos, imágenes y otros contenidos habituales.",
    },
    {
        question: "¿Cómo se define el presupuesto?",
        answer:
            "El presupuesto se define según los objetivos, las funcionalidades, el contenido y los plazos del proyecto. Antes de comenzar recibirás una propuesta con el alcance detallado.",
    },
    {
        question: "¿Puedo solicitar mejoras después del lanzamiento?",
        answer:
            "Sí, podemos acordar mejoras puntuales o un servicio de mantenimiento según las necesidades que aparezcan después de publicar el proyecto.",
    },
];
---

<Layout title="Servicios | Diego Escurra">
    <main>
        <div class="mx-auto max-w-[1440px] px-5 pb-8 pt-14 md:pt-20 lg:px-9 lg:pb-12">
            <section class="border-b border-[var(--color-border)] pb-8 md:pb-10">
                <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)]">SERVICIOS</p>
                <h1
                    class="mt-3 max-w-[760px] text-4xl font-semibold leading-[1.06] tracking-[-0.05em] text-[var(--color-primary)] sm:text-5xl lg:text-[3.5rem]"
                >
                    Desarrollo web para las<br class="hidden sm:block" /> necesidades de tu negocio.
                </h1>
                <p class="mt-3 max-w-[760px] text-base leading-7 text-[var(--color-text)] sm:text-lg">
                    Creo sitios y aplicaciones, conecto herramientas y mejoro plataformas existentes.
                </p>
                <a
                    href={WHATSAPP_URL}
                    target="_blank"
                    rel="noreferrer"
                    class="mt-5 inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
                >
                    Conversemos sobre tu proyecto
                    <ArrowRight class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
                </a>
            </section>

            <section aria-label="Servicios ofrecidos">
                {
                    services.map((service) => (
                        <article class="grid gap-7 border-b border-[var(--color-border)] py-8 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-14 md:py-5">
                            <div class="md:py-4">
                                <h2 class="text-2xl font-semibold tracking-[-0.035em] text-[var(--color-primary)] sm:text-3xl">
                                    {service.title}
                                </h2>
                                <p class="mt-3 max-w-[560px] text-base leading-6 text-[var(--color-text)]">
                                    {service.description}
                                </p>
                                {service.link && (
                                    <div class="mt-5 flex flex-wrap items-center gap-5">
                                        <a
                                            href={service.link}
                                            class="inline-flex items-center gap-2 font-medium text-[var(--color-accent)] transition-colors hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]"
                                        >
                                            {service.linkLabel}
                                            <ArrowRight class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
                                        </a>
                                        {service.badge && (
                                            <span class="rounded-full border border-[var(--color-border)] px-4 py-1.5 text-xs font-medium text-[var(--color-text)]">
                                                {service.badge}
                                            </span>
                                        )}
                                    </div>
                                )}
                            </div>
                            <Image src={service.image} alt={service.imageLabel} width="640" height="340" />
                        </article>
                    ))
                }
            </section>

            <section class="py-8 md:py-10" aria-labelledby="faq-title">
                <h2
                    id="faq-title"
                    class="text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]"
                >
                    Preguntas frecuentes
                </h2>
                <div class="mt-2 border-b border-[var(--color-border)]">
                    {
                        questions.map(({ question, answer }) => (
                            <details class="faq-item group border-t border-[var(--color-border)] first:border-t-0">
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-medium text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">
                                    <span>{question}</span>
                                    <ChevronDown
                                        class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180"
                                        stroke-width={2}
                                        aria-hidden="true"
                                    />
                                </summary>
                                <p class="max-w-[760px] pb-5 pr-10 leading-6 text-[var(--color-text)]">{answer}</p>
                            </details>
                        ))
                    }
                </div>
            </section>

            <section
                class="flex flex-col gap-6 rounded-lg bg-[var(--color-accent-soft)] px-6 py-7 md:flex-row md:items-center md:justify-between md:px-8"
                aria-labelledby="services-cta-title"
            >
                <div>
                    <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-primary-soft)]">CONVERSEMOS</p>
                    <h2
                        id="services-cta-title"
                        class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-[var(--color-primary)] sm:text-3xl"
                    >
                        Cuéntame qué necesitas resolver.
                    </h2>
                    <p class="mt-2 leading-6 text-[var(--color-primary-soft)]">
                        Puedes compartir tu idea o el enlace de tu sitio actual y explicar qué te gustaría mejorar.
                    </p>
                </div>
                <a
                    href={WHATSAPP_URL}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-[var(--color-accent)] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
                >
                    Hablemos de tu proyecto
                    <ArrowRight class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
                </a>
            </section>
        </div>
    </main>
</Layout>

<style>
    summary::-webkit-details-marker {
        display: none;
    }
</style>
