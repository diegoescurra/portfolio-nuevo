---
const steps = [
	{
		number: '01',
		title: 'Conversamos',
		description: 'Objetivos, público y necesidades.',
	},
	{
		number: '02',
		title: 'Definimos el alcance',
		description: 'Entregables, presupuesto y plazos.',
	},
	{
		number: '03',
		title: 'Desarrollo y revisión',
		description: 'Te comparto avances y revisamos los ajustes acordados.',
	},
	{
		number: '04',
		title: 'Publicamos',
		description: 'Puesta en marcha y opciones de mantenimiento.',
	},
];
---

<section class="mx-auto max-w-[1440px] border-t border-[var(--color-border)] px-5 pb-12 pt-18 lg:px-9 lg:pb-14 lg:pt-24">
	<div class="grid gap-6 md:grid-cols-2 md:items-end">
		<div>
			<p class="text-sm font-bold tracking-[0.14em] text-[var(--color-text)]">PROCESO DE TRABAJO</p>
			<h2 class="mt-2 text-4xl font-semibold tracking-[-0.04em] text-[var(--color-primary)] sm:text-5xl">De la idea al resultado</h2>
		</div>
		<p class="max-w-[480px] text-lg leading-7 text-[var(--color-primary-soft)]">
			Un proceso claro, con decisiones compartidas y visibilidad sobre cada etapa.
		</p>
	</div>

	<ol class="mt-12 grid gap-8 md:grid-cols-4 md:gap-6">
		{steps.map(({ number, title, description }) => (
			<li class="border-t border-[var(--color-text-muted)] pt-5">
				<span class="text-4xl font-semibold tracking-[-0.05em] text-[var(--color-accent)]" aria-hidden="true">{number}</span>
				<h3 class="mt-7 text-xl font-semibold tracking-[-0.02em] text-[var(--color-primary)]">{title}</h3>
				<p class="mt-3 text-base leading-6 text-[var(--color-text)]">{description}</p>
			</li>
		))}
	</ol>
</section>
