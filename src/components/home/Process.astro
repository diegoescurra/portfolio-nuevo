---
const steps = [['01', 'Conversamos', 'Entiendo tus objetivos, necesidades y público.'], ['02', 'Planificamos', 'Definimos alcance, funcionalidades y tiempos.'], ['03', 'Desarrollamos', 'Transformo la idea en una solución funcional y visualmente sólida.'], ['04', 'Lanzamos y acompañamos', 'Publicamos tu proyecto y te apoyo en su evolución.']];
---
<section class="mx-auto max-w-[1440px] border-t border-[var(--color-border)] px-5 py-18 lg:px-9 lg:py-24"><div class="grid gap-6 md:grid-cols-2 md:items-end"><div><p class="text-sm font-bold tracking-[0.14em] text-[var(--color-text)]">PROCESO DE TRABAJO</p><h2 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">De la idea al resultado</h2></div><p class="max-w-[440px] leading-5 text-[var(--color-text)]">Un proceso simple y transparente, con comunicación constante en cada etapa.</p></div><div class="mt-10 grid gap-8 md:grid-cols-4 md:gap-5">{steps.map(([number, title, description]) => (<article class="relative border-t border-[var(--color-border)] pt-7 text-sm md:border-t-0 md:pt-0"><span class="mb-5 flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-surface-soft)] font-semibold text-[var(--color-primary)]">{number}</span><h3 class="font-semibold text-[var(--color-primary)]">{title}</h3><p class="mt-2 leading-5 text-[var(--color-text)]">{description}</p></article>))}</div></section>
