---
import Image from "astro/components/Image.astro";


const {data} = Astro.props;

console.log(data);

---

<section class="mx-auto max-w-[1440px] px-5 py-18 lg:px-9 lg:py-24">
    <div class="flex items-end justify-between gap-6"><div>
        <p class="text-[10px] font-bold tracking-[0.14em] text-[var(--color-text)]">PROYECTOS DESTACADOS</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">Trabajo que genera impacto</h2>
    </div><a href="/proyectos" class="hidden text-[11px] font-medium text-[var(--color-primary)] sm:block">Ver todos los proyectos</a>
</div>
<div class="mt-8 grid gap-4 md:grid-cols-2">
    {data.map(({id, data: {title, subtitle, description, category, stack, cover, coverAlt}}) => 
    (<article class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]">
        <div class="relative aspect-[1.56] bg-[var(--color-surface-soft)]">
            <Image src={cover} alt={coverAlt} /> 
            <span class="absolute right-3 top-3 ronded-full bg-[var(--color-surface)] px-3 py-1 text-[9px] font-medium text-[var(--color-primary)]">{category}</span>
            </div>
            <div class="p-5">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-base font-semibold text-[var(--color-primary)]">{title}</h3>
                        <p class="mt-1 text-[11px] leading-5 text-[var(--color-text)]">{description}</p>
                        </div>
                        <span class="h-8 w-8 shrink-0 rounded-full border border-[var(--color-border)]" aria-hidden="true"></span>
                        </div>
                        <div class="mt-4 flex flex-wrap gap-2">{stack.map((item) => 
                            <span class="rounded bg-[var(--color-surface-soft)] px-2 py-1 text-[9px] text-[var(--color-text)]">{item}</span>)}
                            </div>
                            </div>
                            </article>))}
                            </div>
</section>
