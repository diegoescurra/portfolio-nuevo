---
import Image from "astro/components/Image.astro";
import heroImage from "@/assets/images/hero-home.png";
---

<section
	class="grid overflow-hidden lg:grid-cols-2"
>
	<div class="flex flex-col justify-center px-5 pb-12 pt-28 text-base text-[var(--color-primary-soft)] lg:pb-8 lg:pl-[max(2.25rem,calc((100vw-1440px)/2+2.25rem))] lg:pr-12 lg:pt-32">
		<p
			class="mb-4 text-sm font-bold tracking-[0.16em] text-[var(--color-text)]"
		>
			DESARROLLO WEB A TU MEDIDA
		</p>
		<h1
			class="max-w-[520px] text-4xl font-semibold leading-[1.08] tracking-[-0.05em] text-[var(--color-primary)] sm:text-5xl lg:text-[3.5rem]"
		>
			Sitios y aplicaciones web para hacer avanzar tu negocio
		</h1>
		<p
			class="mt-5 max-w-[480px] leading-6 text-[var(--color-primary-soft)]"
		>
			Desarrollo sitios y aplicaciones web que ayudan a negocios y
			organizaciones a crecer, simplificar procesos y conectar con sus
			usuarios.
		</p>
		<div class="mt-7 flex flex-wrap gap-4">
			<a
				href="/contacto"
			class="rounded-xl bg-[var(--color-accent)] px-6 py-4 text-sm font-medium text-white"
				>Hablemos de tu proyecto</a
			><a
				href="/proyectos"
				class="rounded-xl border border-[var(--color-primary-soft)] px-6 py-4 text-sm font-medium text-[var(--color-primary)]"
				>Ver proyectos</a
			>
		</div>
		<div class="mt-10 grid grid-cols-3 divide-x divide-[var(--color-border)] text-sm text-[var(--color-text)]">
			<div>
				<strong class="block text-base text-[var(--color-primary)]"
					>5+</strong
				><span class="mt-1 block"
					>proyectos en producción</span
				>
			</div><div class="pl-5">
				<strong class="block text-base text-[var(--color-primary)]"
					>3+</strong
				><span class="mt-1 block"
					>años de experiencia</span
				>
			</div><div class="pl-5">
				<strong class="block text-base text-[var(--color-primary)]"
					>Trato directo</strong
				><span class="mt-1 block"
					>conmigo durante todo el proyecto</span
				>
			</div>
		</div>
	</div>
	<div
		class="relative min-h-[380px] overflow-hidden lg:min-h-[540px]"
	>
		<Image
			src={heroImage}
			alt="Proyecto destacado"
			class="absolute inset-0 h-full w-full object-cover object-center [mask-image:linear-gradient(to_right,transparent,black_20%)]"
		/>
	</div>
</section>
