---
import {Monitor, Layers3, Link2, Wrench} from "@lucide/astro";



const services = [
  {
    title: "Sitios web",
    description:
      "Landing pages, sitios corporativos y páginas para servicios.",
    icon: Monitor,
  },
  {
    title: "Aplicaciones web",
    description:
      "Sistemas a medida, paneles, formularios y gestión de datos.",
    icon: Layers3,
  },
  {
    title: "Integraciones",
    description:
      "Conexión con APIs, servicios externos y automatizaciones.",
    icon: Link2,
  },
  {
    title: "Mantenimiento",
    description:
      "Optimización, mejoras y soporte para sistemas existentes.",
    icon: Wrench,
  },
];
---

<section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]">
    <div
        class="mx-auto grid max-w-[1440px] divide-y divide-[var(--color-border)] px-5 md:grid-cols-2 md:divide-x md:divide-y-0 lg:grid-cols-4 lg:px-9"
    >
        {
            services.map(({ title, description, icon : Icon }) => (
                <article class="py-8 text-sm md:px-7 md:first:pl-0 lg:px-8">
                    <>
                        <Icon class="h-6 w-6 text-[var(--color-primary)]" />
                        <h2 class="font-semibold text-[var(--color-primary)]">{title}</h2>
                        <p class="mt-2 leading-5 text-[var(--color-text)]">{description}</p>
                    </>
                </article>
            ))
        }
    </div>
</section>
