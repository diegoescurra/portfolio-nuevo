---
import {Monitor, Layers3, Link2, Wrench} from "@lucide/astro";



const services = [
  {
    title: "Sitios web",
    description:
      "Landing pages, sitios corporativos y páginas para servicios.",
    icon: Monitor,
  },
  {
    title: "Aplicaciones web",
    description:
      "Sistemas a medida, paneles, formularios y gestión de datos.",
    icon: Layers3,
  },
  {
    title: "Conexiones y automatización",
    description:
      "Conecto formularios, reservas y herramientas para reducir tareas manuales.",
    icon: Link2,
  },
  {
    title: "Mantenimiento",
    description:
      "Optimización, mejoras y soporte para sistemas existentes.",
    icon: Wrench,
  },
];
---

<section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]">
    <div
        class="services-grid mx-auto grid max-w-[1440px] px-5 md:grid-cols-2 lg:grid-cols-4 lg:px-9"
    >
        {
            services.map(({ title, description, icon : Icon }) => (
                <article class="service text-sm">
                    <>
                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-accent-soft)] text-[var(--color-accent)]">
                            <Icon class="h-6 w-6" stroke-width={2} />
                        </div>
                        <h2 class="mt-5 text-base font-semibold text-[var(--color-primary)]">{title}</h2>
                        <p class="mt-2 leading-6 text-[var(--color-primary-soft)]">{description}</p>
                    </>
                </article>
            ))
        }
    </div>
</section>

<style>
    .service {
        padding-block: 2.25rem;
        border-bottom: 1px solid var(--color-border);
    }

    .service:last-child {
        border-bottom: 0;
    }

    @media (min-width: 48rem) {
        .service {
            padding: 2.25rem 1.75rem;
            border-bottom: 0;
        }

        .service:nth-child(odd) {
            padding-left: 0;
            border-right: 1px solid var(--color-border);
        }

        .service:nth-child(even) {
            padding-right: 0;
        }

        .service:nth-child(-n + 2) {
            border-bottom: 1px solid var(--color-border);
        }
    }

    @media (min-width: 64rem) {
        .service:nth-child(n) {
            padding: 2.5rem 2rem;
            border-right: 1px solid var(--color-border);
            border-bottom: 0;
        }

        .service:first-child {
            padding-left: 0;
        }

        .service:last-child {
            padding-right: 0;
            border-right: 0;
        }
    }
</style>
