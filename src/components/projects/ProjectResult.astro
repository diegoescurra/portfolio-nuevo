---
import { ChartNoAxesColumnIncreasing } from '@lucide/astro';

interface Props {
    paragraphs?: string[];
}

const { paragraphs = [] } = Astro.props;
---

{paragraphs.length > 0 && (
    <section class="mx-auto max-w-[1440px] px-5 pb-8 lg:px-9 lg:pb-10">
        <div class="grid items-start gap-6 border-y border-[var(--color-border)] py-7 sm:grid-cols-[64px_160px_minmax(0,1fr)] sm:gap-8">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)]" aria-hidden="true"><ChartNoAxesColumnIncreasing size={25} strokeWidth={1.8} /></span>
            <h2 class="text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">Resultado</h2>
            <div class="max-w-3xl space-y-4 text-base leading-7 text-[var(--color-text)]">
                {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
        </div>
    </section>
)}
