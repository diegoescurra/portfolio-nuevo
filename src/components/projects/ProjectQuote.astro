---
interface Props {
    title?: string;
    quote: string;
    client: string;
    author?: string;
    authorRole?: string;
}

const { title, quote, client, author, authorRole } = Astro.props;
---


    <section class="mx-auto max-w-[1440px] px-5 pb-12 lg:px-9 lg:pb-14">
        <figure class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-7 sm:px-8 sm:py-8">
            <blockquote class="max-w-5xl font-serif text-2xl leading-[1.35] italic text-[var(--color-primary)] sm:text-3xl">{title ?? quote}</blockquote>
            {title && <p class="mt-5 max-w-5xl text-base leading-7 text-[var(--color-primary-soft)]">{quote}</p>}

            <figcaption class="mt-7 border-t border-[var(--color-border)] pt-6">
                <p class="font-semibold text-[var(--color-primary)]">{author ?? client}</p>
                <p class="mt-1 text-sm text-[var(--color-text)]">{authorRole ?? 'Cliente'}</p>
            </figcaption>
        </figure>
    </section>
