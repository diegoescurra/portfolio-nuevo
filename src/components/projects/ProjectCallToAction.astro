---
import { ArrowRight } from '@lucide/astro';
---

<section class="mx-auto max-w-[1440px] px-5 pb-14 lg:px-9 lg:pb-16">
    <div class="rounded-2xl bg-[var(--color-accent-soft)] px-6 py-8 sm:px-10 sm:py-10">
        <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-accent)] uppercase">¿Tienes un proyecto similar?</p>
        <div class="mt-3 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div><h2 class="text-3xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">Hablemos sobre tu idea</h2><p class="mt-2 text-[var(--color-text)]">Cuéntame lo que necesitas y veamos cómo hacerlo realidad.</p></div>
            <a href="/contacto" class="flex w-fit items-center gap-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90">Contactar<ArrowRight size={15} strokeWidth={1.75} aria-hidden="true" /></a>
        </div>
    </div>
</section>
