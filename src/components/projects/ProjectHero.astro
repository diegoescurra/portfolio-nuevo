---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ExternalLink } from '@lucide/astro';

type Project = CollectionEntry<'projects'>;

interface Props {
    project: Project['data'];
    previousProject?: Project;
    nextProject?: Project;
}

const { project, previousProject, nextProject } = Astro.props;
---

<section class="mx-auto max-w-[1440px] px-5 pb-10 pt-28 lg:px-9 lg:pb-12 lg:pt-30">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 text-sm">
        <a href="/proyectos" class="font-medium text-[var(--color-primary)] transition-colors hover:text-[var(--color-accent)]">
            <span class="flex items-center gap-2"><ArrowLeft size={15} strokeWidth={1.75} aria-hidden="true" />Volver a proyectos</span>
        </a>
        <nav class="flex items-center gap-5 text-[var(--color-text)]" aria-label="Navegación entre proyectos">
            {previousProject && <a href={`/proyectos/${previousProject.id}`} class="flex items-center gap-2 hover:text-[var(--color-primary)]"><ArrowLeft size={15} strokeWidth={1.75} aria-hidden="true" />Proyecto anterior</a>}
            {nextProject && <a href={`/proyectos/${nextProject.id}`} class="flex items-center gap-2 hover:text-[var(--color-primary)]">Proyecto siguiente<ArrowRight size={15} strokeWidth={1.75} aria-hidden="true" /></a>}
        </nav>
    </div>

    <div class="mt-10 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
            <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)] uppercase">{project.category} · {project.role}</p>
            <h1 class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-[var(--color-primary)] sm:text-5xl">{project.title}</h1>
            <p class="mt-4 max-w-xl text-xl leading-8 text-[var(--color-primary-soft)]">{project.description}</p>

            <div class="mt-8 flex flex-wrap gap-3">
                {project.website && <a href={project.website} target="_blank" rel="noopener noreferrer" aria-label={`Visitar el sitio de ${project.title} (se abre en una nueva pestaña)`} class="flex items-center gap-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90">Visitar sitio<ExternalLink size={15} strokeWidth={1.75} aria-hidden="true" /></a>}
                {project.repository && <a href={project.repository} target="_blank" rel="noopener noreferrer" aria-label={`Ver el código de ${project.title} (se abre en una nueva pestaña)`} class="flex items-center gap-2 rounded-xl border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-primary)] transition-colors hover:border-[var(--color-primary)]">Ver código<ExternalLink size={15} strokeWidth={1.75} aria-hidden="true" /></a>}
            </div>
        </div>

        <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-[var(--color-surface-soft)]">
            <Image
                src={project.cover}
                alt={project.coverAlt}
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="h-full w-full object-cover"
                style={`object-position: ${project.coverPosition}`}
            />
        </div>
    </div>
</section>
