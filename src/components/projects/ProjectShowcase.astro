---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
    items?: CollectionEntry<'projects'>['data']['showcase'];
}

const { items = [] } = Astro.props;
const visibleItems = items.filter((item) => item.image);
const desktopItems = visibleItems.filter((item) => item.imageLayout === 'landscape');
const mobileItems = visibleItems.filter((item) => item.imageLayout === 'portrait');
const galleryItems = [...desktopItems, ...mobileItems];
---

{galleryItems.length > 0 && (
    <section class="mx-auto max-w-[1440px] px-5 pb-12 lg:px-9 lg:pb-14">
        <div class:list={["grid items-start gap-10", galleryItems.length > 1 && "lg:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] lg:gap-8"]}>
            {galleryItems.map((item) => (
                <figure class:list={[galleryItems.length === 1 && (item.imageLayout === 'portrait' ? "mx-auto max-w-sm" : "max-w-3xl")] }>
                    <div class:list={["showcase-media flex items-start", item.imageLayout === 'portrait' && "justify-center"]}>
                        <Image
                            src={item.image!}
                            alt={item.imageAlt ?? item.title}
                            widths={item.imageLayout === 'portrait' ? [480, 640, 960] : [640, 960, 1280, 1600]}
                            sizes={item.imageLayout === 'portrait' ? "(min-width: 1024px) 33vw, 100vw" : "(min-width: 1024px) 66vw, 100vw"}
                            class:list={[
                                "h-auto max-w-full",
                                item.imageLayout === 'portrait' ? "max-h-[30rem] w-auto" : "w-full rounded-xl border border-[var(--color-border)]",
                            ]}
                        />
                    </div>
                    <figcaption class="mt-5 max-w-[68ch]">
                        <h2 class="text-2xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">{item.title}</h2>
                        <p class="mt-3 leading-7 text-[var(--color-text)]">{item.description}</p>
                    </figcaption>
                </figure>
            ))}
        </div>
    </section>
)}

<style>
    @media (min-width: 1024px) {
        .showcase-media {
            height: 30rem;
        }
    }
</style>
