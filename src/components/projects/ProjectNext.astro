---
import { ArrowRight } from '@lucide/astro';

interface Props {
    id: string;
    title: string;
    category: string;
}

const { id, title, category } = Astro.props;
---

<section class="mx-auto max-w-[1440px] px-5 pb-8 lg:px-9 lg:pb-10">
    <a href={`/proyectos/${id}`} class="group flex items-center justify-between gap-6 border-b border-[var(--color-border)] py-6">
        <div>
            <p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)] uppercase">Siguiente proyecto · {category}</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-[var(--color-primary)] transition-colors group-hover:text-[var(--color-accent)] sm:text-3xl">{title}</h2>
        </div>
        <ArrowRight size={24} strokeWidth={1.75} class="text-[var(--color-accent)] transition-transform group-hover:translate-x-1" aria-hidden="true" />
    </a>
</section>
