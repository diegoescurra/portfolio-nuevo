---
import { Download, Mail } from "@lucide/astro";
import { EMAIL_URL } from '@/contact';
const socialLinks = [
	{ label: 'GitHub', href: 'https://github.com', icon: 'github' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com', icon: 'linkedin' },
];
---

<section class="pb-10 pt-12 md:pb-12 md:pt-16">
	<div>
		<p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)]">DESARROLLO WEB Y SOLUCIONES DIGITALES</p>
		<h1 class="mt-2 text-5xl font-semibold leading-none tracking-[-0.055em] text-[var(--color-primary)] sm:text-6xl">
			Diego Escurra
		</h1>
		<p class="mt-2 text-2xl font-medium tracking-[-0.03em] text-[var(--color-primary)]">Full Stack Developer</p>
		<p class="mt-4 max-w-[720px] text-base leading-7 text-[var(--color-text)]">
			Desarrollo sitios y aplicaciones web, con experiencia en interfaces, integraciones y mantenimiento de sistemas en producción. He trabajado en equipos de desarrollo y directamente con clientes.
		</p>
		<p class="mt-3 text-sm font-medium text-[var(--color-primary-soft)]">
			<span class="mr-2 inline-block size-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
			Abierto a oportunidades · Desarrollo full stack · Remoto o híbrido desde Chile.
		</p>

		<div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
			<a href="/diego-escurra-cv.pdf" download class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary)]">
				<Download size={17} aria-hidden="true" />
				Descargar CV
			</a>
			{socialLinks.map(({ label, href, icon }) => (
				<a href={href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-accent)]">
					{icon === 'github' ? (
						<svg viewBox="0 0 24 24" class="size-[18px] fill-current" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.48.11-3.07 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.78.11 3.07.74.81 1.19 1.84 1.19 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.79.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
					) : (
						<svg viewBox="0 0 24 24" class="size-[18px] fill-current" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47Z" /></svg>
					)}
					{label}
				</a>
			))}
			<a href={EMAIL_URL} class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-accent)]">
				<Mail size={18} aria-hidden="true" />
				Email
			</a>
		</div>
	</div>
</section>
