---
const primarySkills = [
	{ title: 'Frontend e interfaces', tools: ['React', 'Nuxt.js', 'Tailwind CSS'] },
	{ title: 'Backend y APIs', tools: ['Node.js', 'Express'] },
	{ title: 'Bases de datos', tools: ['PostgreSQL', 'MongoDB'] },
	{ title: 'Integraciones', tools: ['REST', 'OpenAI'] },
	{ title: 'Despliegue y mantenimiento', tools: ['Vercel', 'Docker'] },
];

const secondarySkills = ['TypeScript', 'HTML', 'CSS', 'WordPress', 'Git', 'Figma', 'Postman'];
---

<section class="rounded-xl bg-[var(--color-surface-soft)] p-6 sm:p-7">
	<p class="text-xs font-bold tracking-[0.16em] text-[var(--color-primary-soft)]">CAPACIDADES TÉCNICAS</p>
	<h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-[var(--color-primary)]">Tecnologías y herramientas</h2>

	<p class="mt-6 text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-primary-soft)]">Uso habitual</p>
	<dl class="mt-4 space-y-5">
		{primarySkills.map((skill) => (
			<div>
				<dt class="text-sm font-semibold text-[var(--color-primary)]">{skill.title}</dt>
				<dd class="mt-1 leading-6 text-[var(--color-primary-soft)]">{skill.tools.join(' · ')}</dd>
			</div>
		))}
	</dl>

	<div class="mt-6">
		<h3 class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-primary-soft)]">Experiencia en proyectos</h3>
		<p class="mt-2 leading-6 text-[var(--color-primary-soft)]">{secondarySkills.join(' · ')}</p>
	</div>
</section>
