---
const education = [
	{ period: '2021 – 2023', degree: 'Ingeniería de Ejecución en Informática', institution: 'AIEP' },
	{ period: '2018 – 2020', degree: 'Técnico en Programación', institution: 'AIEP' },
];
---

<section class="border-t border-[var(--color-border)] py-10 md:py-12">
	<p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)]">FORMACIÓN</p>
	<h2 class="mt-2 text-3xl font-semibold tracking-[-0.045em] text-[var(--color-primary)] sm:text-4xl">Formación</h2>
	<div class="mt-6 grid max-w-[900px] gap-5 sm:grid-cols-2">
		{education.map((item) => (
			<article class="rounded-lg bg-[var(--color-surface)] p-5">
				<h3 class="text-lg font-semibold leading-snug text-[var(--color-primary)]">{item.degree}</h3>
				<p class="mt-2 font-medium text-[var(--color-primary-soft)]">{item.institution}</p>
				<p class="mt-1 text-sm text-[var(--color-text)]">{item.period}</p>
			</article>
		))}
	</div>
</section>
