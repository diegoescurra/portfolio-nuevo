---
const education = [
	{ period: '2020 – 2023', degree: 'Ingeniería de Ejecución en Informática', institution: 'AIEP' },
	{ period: '2018 – 2020', degree: 'Técnico en Programación', institution: 'AIEP' },
];
---

<section class="border-t border-[var(--color-border)] py-10 md:py-12">
	<p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)]">FORMACIÓN</p>
	<h2 class="mt-2 text-3xl font-semibold tracking-[-0.045em] text-[var(--color-primary)] sm:text-4xl">Estudios y certificaciones</h2>
	<div class="mt-5 grid gap-6 md:grid-cols-2 md:gap-0">
		{education.map((item, index) => (
			<article class:list={['md:pr-10', { 'border-t border-[var(--color-border)] pt-6 md:border-l md:border-t-0 md:pl-10 md:pt-0': index > 0 }]}>
				<p class="text-sm text-[var(--color-text)]">{item.period}</p>
				<h3 class="mt-1 text-lg font-medium text-[var(--color-primary)]">{item.degree}</h3>
				<p class="font-semibold text-[var(--color-primary-soft)]">{item.institution}</p>
			</article>
		))}
	</div>
</section>
