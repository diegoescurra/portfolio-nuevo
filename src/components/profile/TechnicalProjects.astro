---
import { ArrowUpRight } from "@lucide/astro";

const projects = [
	{
		title: "Experiencia Tomasina",
		participation:
			"Participé en el desarrollo del sitio web de Santo Tomás con Nuxt 3 y TypeScript, integrando contenido desde WordPress y utilizando generación estática (SSG) como parte del equipo de IDA.",
		href: "https://experienciatomasina.ust.cl/",
	},
	{
		title: "CCLM",
		participation:
			"Realicé mantenimiento, corrección de incidencias y mejoras en la plataforma web del Centro Cultural La Moneda, trabajando con WordPress y PHP como parte del equipo de IDA.",
		href: "https://www.cclm.cl/",
	},
	{
		title: "Training For Women",
		participation:
			"Participe en el desarrollo de una aplicación Full Stack con Nuxt 3 y MongoDB para la gestión de usuarios, ejercicios y rutinas de entrenamiento, incluyendo autenticación y asignación mensual de rutinas.",
		href: "",
	},
];
---

<section class="border-t border-[var(--color-border)] py-10 md:py-12">
	<p class="text-xs font-bold tracking-[0.16em] text-[var(--color-text)]">PROYECTOS DESTACADOS</p>
	<h2
		class="mt-2 text-3xl font-semibold tracking-[-0.045em] text-[var(--color-primary)] sm:text-4xl"
	>
		Proyectos seleccionados
	</h2>

	<div class="mt-7 grid gap-5 md:grid-cols-3">
		{
			projects.map((project) => (
				<article class="flex flex-col rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
					<h3 class="text-xl font-semibold tracking-[-0.02em] text-[var(--color-primary)]">
						{project.title}
					</h3>
					<p class="mt-3 leading-6 text-[var(--color-text)]">{project.participation}</p>
					{project.href && (
						<a
							href={project.href}
							class="mt-5 inline-flex w-fit items-center gap-1 text-sm font-semibold text-[var(--color-accent)] transition-colors hover:text-[var(--color-primary)]"
						>
							Ver caso
							<ArrowUpRight size={16} aria-hidden="true" />
						</a>
					)}
				</article>
			))
		}
	</div>
</section>
