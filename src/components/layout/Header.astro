---

const links = [
	{ href: "/", label: "Inicio" },
	{ href: "/proyectos", label: "Proyectos" },
	{ href: "/servicios", label: "Servicios" },
	{ href: "/perfil-tecnico", label: "Perfil técnico" },
];

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---


<header class:list={[
	"mx-auto grid w-full max-w-[1440px] grid-cols-[1fr_auto] items-center px-5 py-5 md:grid-cols-[1fr_auto_1fr] lg:px-9",
	{ "absolute inset-x-0 top-0 z-10": overlay },
]}>
	<a href="/" class="text-base font-bold tracking-[-0.02em] text-[var(--color-primary)]">Diego Escurra</a>
	<nav class="hidden items-center gap-8 text-sm font-medium text-[var(--color-primary)] md:flex" aria-label="Principal">
		{links.map((item) => (
			<a
				href={item.href}
				aria-current={isActive(item.href) ? 'page' : undefined}
				class:list={[
					"border-b-2 px-0.5 py-2 transition-colors hover:text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]",
					isActive(item.href) ? "border-[var(--color-accent)] text-[var(--color-primary)]" : "border-transparent",
				]}
			>
				{item.label}
			</a>
		))}
	</nav>
	<a
		href="/contacto"
		aria-current={isActive('/contacto') ? 'page' : undefined}
		class:list={[
			"justify-self-end rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]",
			{ "ring-2 ring-[var(--color-primary)] ring-offset-2 ring-offset-[var(--color-bg)]": isActive('/contacto') },
		]}
	>
		Contacto
	</a>
</header>
