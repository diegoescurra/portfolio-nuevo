---
import { WHATSAPP_URL } from '@/contact';

const links = [
	{ href: "/", label: "Inicio" },
	{ href: "/proyectos", label: "Proyectos" },
	{ href: "/servicios", label: "Servicios" },
	{ href: "/perfil-tecnico", label: "Perfil técnico" },
];

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---


<header class:list={[
	"relative z-[110] mx-auto w-full max-w-[1440px]",
	{ "absolute inset-x-0 top-0 z-[100]": overlay },
]}>
	<div class="relative z-[110] grid grid-cols-[1fr_auto] items-center bg-[var(--color-bg)] px-5 py-5 md:grid-cols-[1fr_auto_1fr] lg:px-9">
		<a href="/" class="text-base font-bold tracking-[-0.02em] text-[var(--color-primary)]">Diego Escurra</a>
		<nav class="hidden items-center gap-8 text-sm font-medium text-[var(--color-primary)] md:flex" aria-label="Principal">
			{links.map((item) => (
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class:list={[
						"border-b-2 px-0.5 py-2 transition-colors hover:text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]",
						isActive(item.href) ? "border-[var(--color-accent)] text-[var(--color-primary)]" : "border-transparent",
					]}
				>
					{item.label}
				</a>
			))}
		</nav>
		<a
			href={WHATSAPP_URL}
			target="_blank"
			rel="noreferrer"
			class="hidden justify-self-end rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] md:inline-flex"
		>
			Contacto
		</a>
		<button type="button" class="group relative flex h-11 w-11 items-center justify-center justify-self-end border border-[var(--color-border)] md:hidden" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
			<span class="absolute block h-0.5 w-5 -translate-y-2 bg-[var(--color-primary)] transition-transform duration-300 group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45"></span>
			<span class="absolute block h-0.5 w-5 bg-[var(--color-primary)] transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
			<span class="absolute block h-0.5 w-5 translate-y-2 bg-[var(--color-primary)] transition-transform duration-300 group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45"></span>
		</button>
	</div>
	<nav id="mobile-menu" class="pointer-events-none fixed inset-0 z-[100] flex -translate-y-4 flex-col bg-[var(--color-bg)] px-5 pt-28 text-[var(--color-primary)] opacity-0 transition-[opacity,transform] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden" aria-label="Principal móvil" data-mobile-menu>
		<div>
			{links.map((item) => (
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class:list={[
						"block border-b border-[var(--color-border)] py-6 text-2xl font-semibold tracking-[-0.04em] transition-colors hover:text-[var(--color-accent)]",
						isActive(item.href) ? "text-[var(--color-accent)]" : "",
					]}
				>
					{item.label}
				</a>
			))}
			<a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="block border-b border-[var(--color-border)] py-6 text-2xl font-semibold tracking-[-0.04em] transition-colors hover:text-[var(--color-accent)]">Contacto</a>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const setMenuState = (isOpen: boolean) => {
		toggle?.setAttribute('aria-expanded', String(isOpen));
		toggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
		menu?.classList.toggle('pointer-events-none', !isOpen);
		menu?.classList.toggle('opacity-0', !isOpen);
		menu?.classList.toggle('-translate-y-4', !isOpen);
		document.body.classList.toggle('overflow-hidden', isOpen);
	};

	toggle?.addEventListener('click', () => setMenuState(toggle.getAttribute('aria-expanded') !== 'true'));
</script>
